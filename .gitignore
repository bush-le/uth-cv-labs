# ==============================================================================
# Git Ignore Configuration for UTH Computer Vision Workspace
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
conda-env/

# PyTorch / Deep Learning Artifacts
*.pt
*.pth
*.pwf
*.onnx
*.engine
*.tflite
*.ckpt
*.h5

# PyTorch hub / Torchvision cache
.cache/
torch_cache/
torchvision_cache/

# Experiment outputs and metrics tracking
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep
experiments/logs/*
!experiments/logs/.gitkeep
experiments/predictions/*
!experiments/predictions/.gitkeep

# Weights & Biases (Wandb)
wandb/
.wandb/

# Tensorboard / Hydra outputs
runs/
outputs/
multirun/
*.tfevents.*

# Data layering - Ignore raw/interim/processed heavy files but preserve structure
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Allow sample data and documentation assets
!data/samples/
!docs/assets/

# Archives & Large Media
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.mp4
*.avi
*.mov
*.mkv

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.nbconvert.ipynb

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Secrets & Environment Variables
.env
.env.*
!.env.example
*.pem
*.key
